<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= item ? "Edit Product" : "Add New Product" %> | Electronics Store</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <a href="/" class="back-link">← Back to Home</a>

  <main class="form-container">
    <h1>
        <%= item ? "Edit Product" : "Add New Product" %>
    </h1>
    <% if (typeof errorMessage !== "undefined" && errorMessage) { %>
      <p class="error-message"><%= errorMessage %></p>
    <% } %>
    <p class="form-subtitle">
        <%= item ? "Update your product information." : "Add a product to your inventory." %>
    </p>

    <form action="<%= item ? `/items/${item.id}/edit` : '/items/new' %>" method="POST">

      <div class="form-group">
        <label for="name">Product Name</label>
        <input
          type="text"
          id="name"
          name="name"
          placeholder="e.g. MacBook Pro"
          value="<%= item ? item.name : '' %>"
          required
        >
      </div>

      <div class="form-group">
        <label for="brand">Brand</label>
        <input
          type="text"
          id="brand"
          name="brand"
          placeholder="e.g. Apple"
          value="<%= item ? item.brand || '' : '' %>" |
        >
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea
          id="description"
          name="description"
          placeholder="Describe the product..."
        ><%= item ? item.description || '' : '' %></textarea>
      </div>

      <div class="form-group">
        <label for="price">Price (USD)</label>
        <input
          type="number"
          id="price"
          name="price"
          min="0"
          step="0.01"
          value="<%= item ? item.price : '' %>" |
          required
        >
      </div>

      <div class="form-group">
        <label for="stock_quantity">Stock Quantity</label>
        <input
          type="number"
          id="stock_quantity"
          name="stock_quantity"
          min="0"
          value="0"
          value="<%= item ? item.stock_quantity : 0 %>" |
          required
        >
      </div>

      <div class="form-group">
        <label for="image_url">Product Image URL</label>
        <input
          type="url"
          id="image_url"
          name="image_url"
          placeholder="https://example.com/product.webp"
          value="<%= item ? item.image_url || '' : '' %>" |
        >
      </div>

    <div class="form-group">
        <label for="category_id">Category</label>
        <select id="category_id" name="category_id" required>
            <option value="">Select a category</option>
    
            <% categories.forEach(category=> { %>
                <option value="<%= category.id %>" <%=item && item.category_id===category.id ? "selected" : "" %>
                    >
                    <%= category.name %>
                </option>
                <% }) %>
        </select>
    </div>

    <% if (item) { %>
      <div class="form-group">
        <label for="adminPassword">Admin Password</label>
        <input
          type="password"
          id="adminPassword"
          name="adminPassword"
          placeholder="Enter admin password to confirm changes"
          required
          autocomplete="current-password"
        >
      </div>
    <% } %>

    <button type="submit" class="submit-button">
        <%= item ? "Save Changes" : "Add Product" %>
    </button>

    </form>
  </main>

</body>
</html>